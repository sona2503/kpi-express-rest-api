// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employeeId   Int?      @unique @map("employee_id")
  employee     Employee? @relation(fields: [employeeId], references: [id])

  @@map("users")
}

//tabel employee
enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

model Employee {
  id            Int            @id @default(autoincrement())
  nip           String         @unique @db.VarChar(30)
  nama          String         @db.VarChar(100)
  email         String?        @unique @db.VarChar(100)
  department    String?        @db.VarChar(100)
  position      String?        @db.VarChar(100)
  tanggalMasuk  DateTime       @map("tanggal_masuk") @db.Date
  status        EmployeeStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user          User?
  attendances   Attendance[]
  behaviors     Behavior[]
  projectMembers  ProjectMember[]
  tasks           Task[]

  @@map("employees")
}

//tabel attendances(kehadiran)
enum AttendanceStatus {
  HADIR
  TELAT
  IZIN
  SAKIT
  ALFA
}

model Attendance {
  id          Int              @id @default(autoincrement())
  employeeId  Int              @map("employee_id")
  employee    Employee         @relation(fields: [employeeId], references: [id])
  tanggal     DateTime         @db.Date
  jamMasuk    DateTime?        @map("jam_masuk")
  jamKeluar   DateTime?        @map("jam_keluar")
  status      AttendanceStatus @default(HADIR)
  catatan     String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([employeeId, tanggal]) // cegah presensi ganda di hari yang sama
  @@map("attendances")
}

//tabel behaviors (prilaku karyawan)
enum BehaviorRating {
  SANGAT_BAIK
  BAIK
  CUKUP
  KURANG
  SANGAT_KURANG
}

model Behavior {
  id          Int            @id @default(autoincrement())
  employeeId  Int            @map("employee_id")
  employee    Employee       @relation(fields: [employeeId], references: [id])
  periode     String         @db.VarChar(7)   // format "YYYY-MM", contoh "2026-09"
  rating      BehaviorRating
  catatan     String?        @db.Text
  penilaiId   Int?           @map("penilai_id") // opsional, id User yang menilai
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([employeeId, periode]) // satu penilaian per karyawan per periode
  @@map("behaviors")
}

//tabel project, project member dan task project
enum ProjectStatus {
  PLANNING
  ON_PROGRESS
  DONE
  CANCELLED
}

model Project {
  id          Int           @id @default(autoincrement())
  nama        String        @db.VarChar(150)
  deskripsi   String?       @db.Text
  startDate   DateTime      @map("start_date") @db.Date
  deadline    DateTime?     @db.Date
  status      ProjectStatus @default(PLANNING)
  managerId   Int?          @map("manager_id") // employeeId penanggung jawab
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  members     ProjectMember[]
  tasks       Task[]

  @@map("projects")
}

model ProjectMember {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  peran      String?  @db.VarChar(50) // contoh: "Lead", "Developer", "QA"
  joinedAt   DateTime @default(now()) @map("joined_at")

  @@unique([projectId, employeeId]) // satu karyawan sekali daftar per project
  @@map("project_members")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model Task {
  id           Int          @id @default(autoincrement())
  projectId    Int          @map("project_id")
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  judul        String       @db.VarChar(150)
  deskripsi    String?      @db.Text
  assigneeId   Int?         @map("assignee_id")
  assignee     Employee?    @relation(fields: [assigneeId], references: [id])
  prioritas    TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  estimasiJam  Float?       @map("estimasi_jam")
  dueDate      DateTime?    @map("due_date")
  startedAt    DateTime?    @map("started_at")
  completedAt  DateTime?    @map("completed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("project_tasks")
}

